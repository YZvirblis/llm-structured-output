{
  "name": "llm-structured-output",
  "version": "0.1.0",
  "private": true,
  "description": "Extracting a structured side-channel (dice rolls, image requests) out of an LLM response that must also produce prose.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "llm",
    "structured-output",
    "parser",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
